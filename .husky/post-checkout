#!/bin/sh
# Best-effort: regenerate types.ts after a branch checkout that changed openapi.json.
# Always exits 0, silent, offline, no TTY needed. $1/$2 = previous/new HEAD, $3 = 1 for branches.
[ -n "$CI" ] && exit 0
[ "$3" = "1" ] || exit 0
git diff --quiet "$1" "$2" -- openapi.json >/dev/null 2>&1 && exit 0
npm run --silent types:ensure >/dev/null 2>&1 || true
exit 0
